# Normalize line endings to LF on checkout
* text=auto eol=lf

# Explicitly declare text files
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.svg binary

# Lock files — do not diff
package-lock.json -diff linguist-generated

# Design System previews — generated HTML/CSS, exclude from language stats
Stella\ Design\ System/preview/** linguist-generated
Stella\ Design\ System/*.css linguist-generated
Stella\ Design\ System/ui_kits/** linguist-generated
